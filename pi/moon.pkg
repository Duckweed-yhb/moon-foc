///|
/// pi — 单轴离散 PI 调节器（纯计算，四后端）
///
/// FOC 电流环的「误差 → 电压指令」环节：给定 d/q 轴电流误差，输出一个
/// 电压指令交给 svpwm。与 svpwm 分开是因为两者输入输出不是一回事：
/// 调制是「电压 → 占空比」的映射，PI 是反馈。
///
/// 约定：
///   - 增量式积分项，`ki·err·dt` 累加到 `integ`，`integ` 即积分项对输出的贡献
///   - 条件积分抗饱和：输出顶到限幅且误差继续同向推时冻结积分器
///   - 非有限误差不进入状态
supported_targets = "wasm+wasm-gc+js+native"
