///|
/// motor — 简化 PMSM 电气模型与单惯量机械模型（纯计算，四后端）
///
/// 离线仿真用的 d/q 轴一阶模型：电阻电感 + 永磁磁链反电势，显式欧拉积分。
/// 电角速度由外部给定；不含无感观测器；不代表真实电机的
/// 饱和、齿槽与高频动态。参数含 Ld / Lq、磁链、极对数。
/// mechanical.mbt 是机械侧：电磁转矩换算与 J·dωm/dt = Te − TL − B·ωm 的积分，
/// 转速钳非负，不做四象限与反转。
supported_targets = "wasm+wasm-gc+js+native"

import {
  "Duckweed/moon-foc/angle",
  "Duckweed/moon-foc/coord",
}
