/// coord 往返测试：Clarke ↔ invClarke，Park ↔ invPark，以及对称三相直流量。

fn approx_equal(x : Double, y : Double, eps : Double) -> Bool {
  (x - y).abs() < eps
}

let eps = 0.000000001

test "clarke: balanced three-phase DC" {
  // ia=1, ib=-0.5, ic=-0.5  →  alpha=1, beta=0
  let (a, b) = @coord.clarke(1.0, -0.5, -0.5)
  assert_true(approx_equal(a, 1.0, eps))
  assert_true(approx_equal(b, 0.0, eps))
}

test "clarke: zero sum → inv_clarke roundtrip" {
  let (ia, ib, ic) = (0.7, -0.3, -0.4)
  let (a, b) = @coord.clarke(ia, ib, ic)
  let (ia2, ib2, ic2) = @coord.inv_clarke(a, b)
  assert_true(approx_equal(ia2, ia, eps))
  assert_true(approx_equal(ib2, ib, eps))
  assert_true(approx_equal(ic2, ic, eps))
}

test "inv_clarke: ia+ib+ic == 0" {
  let (ia, ib, ic) = @coord.inv_clarke(0.3, 0.8)
  assert_true(approx_equal(ia + ib + ic, 0.0, eps))
}

test "park: theta=0 identity" {
  // theta=0 → d=alpha, q=beta
  let (d, q) = @coord.park(0.4, 0.9, 0.0)
  assert_true(approx_equal(d, 0.4, eps))
  assert_true(approx_equal(q, 0.9, eps))
}

test "park: theta=pi/2" {
  // cos(pi/2)=0, sin(pi/2)=1 → d=beta, q=-alpha
  let (d, q) = @coord.park(0.4, 0.9, 1.5707963267948966)
  assert_true(approx_equal(d, 0.9, eps))
  assert_true(approx_equal(q, -0.4, eps))
}

test "park / inv_park roundtrip" {
  let (d, q) = (0.6, -0.3)
  let theta = 0.7
  let (a, b) = @coord.inv_park(d, q, theta)
  let (d2, q2) = @coord.park(a, b, theta)
  assert_true(approx_equal(d2, d, eps))
  assert_true(approx_equal(q2, q, eps))
}

// 20 组独立基准：由 `scripts/gen_fixtures.py` 按教材公式计算（Python 独立实现，
// 不读取本库输出）。电流幅值 1/5/10/20 A 轮换，Park 角覆盖 0 到 1.9π。
test "fixtures: 20 independent coord cases" {
  let inputs : Array[(Double, Double, Double, Double)] = [(1.0, -0.4999999999999998, -0.4999999999999998, 0.0), (4.755282581475767, -1.0395584540887957, -3.7157241273869706, 0.15707963267948966), (8.090169943749475, 1.0452846326765368, -9.135454576426007, 0.3141592653589793), (11.755705045849464, 8.134732861516007, -19.890437907365467, 0.47123889803846897), (0.30901699437494745, 0.6691306063588583, -0.9781476007338057, 0.6283185307179586), (3.061616997868383e-16, 4.330127018922194, -4.3301270189221945, 0.7853981633974483), (-3.0901699437494736, 9.781476007338057, -6.691306063588584, 0.9424777960769379), (-11.75570504584946, 19.890437907365467, -8.134732861516019, 1.0995574287564276), (-0.8090169943749473, 0.9135454576426009, -0.10452846326765423, 1.2566370614359172), (-4.755282581475767, 3.7157241273869706, 1.0395584540887928, 1.413716694115407), (-10.0, 4.999999999999999, 4.999999999999993, 1.5707963267948966), (-19.021130325903076, 4.158233816355193, 14.862896509547873, 1.727875959474386), (-0.8090169943749475, -0.10452846326765355, 0.9135454576426005, 1.8849555921538759), (-2.9389262614623664, -2.033683215379001, 4.972609476841367, 2.0420352248333655), (-3.0901699437494754, -6.691306063588582, 9.781476007338059, 2.199114857512855), (-3.673940397442059e-15, -17.320508075688775, 17.32050807568878, 2.356194490192345), (0.30901699437494723, -0.9781476007338057, 0.6691306063588589, 2.5132741228718345), (2.9389262614623646, -4.972609476841367, 2.033683215379005, 2.670353755551324), (8.090169943749473, -9.135454576426008, 1.0452846326765437, 2.827433388230814), (19.02113032590307, -14.862896509547884, -4.158233816355169, 2.9845130209103035)]
  let expected : Array[(Double, Double, Double, Double)] = [(1.0, 0.0, 1.0, 0.0), (4.755282581475766, 1.5450849718747375, 4.9384417029756875, 0.782172325201155), (8.090169943749473, 5.877852522924733, 9.510565162951535, 3.0901699437494763), (11.755705045849462, 16.180339887498953, 17.820130483767358, 9.079809994790942), (0.3090169943749474, 0.9510565162951538, 0.8090169943749476, 0.5877852522924734), (5.921189464667501e-16, 5.000000000000002, 3.5355339059327395, 3.5355339059327386), (-3.090169943749473, 9.510565162951538, 5.8778525229247345, 8.090169943749475), (-11.755705045849455, 16.18033988749896, 9.079809994790947, 17.820130483767354), (-0.8090169943749471, 0.5877852522924737, 0.309016994374948, 0.9510565162951534), (-4.7552825814757655, 1.5450849718747393, 0.7821723252011566, 4.938441702975687), (-9.999999999999996, 3.589530347915986e-15, 2.9772069483423097e-15, 9.999999999999996), (-19.021130325903073, -6.180339887498939, -3.1286893008046137, 19.753766811902754), (-0.8090169943749472, -0.587785252292473, -0.30901699437494745, 0.9510565162951533), (-2.938926261462366, -4.045084971874738, -2.269952498697735, 4.45503262094184), (-3.0901699437494754, -9.510565162951538, -5.877852522924734, 8.090169943749476), (-4.736951571734001e-15, -20.000000000000007, -14.142135623730953, 14.142135623730958), (0.30901699437494706, -0.9510565162951541, -0.8090169943749475, 0.5877852522924737), (2.9389262614623637, -4.04508497187474, -4.455032620941839, 2.2699524986977364), (8.09016994374947, -5.877852522924736, -9.510565162951533, 3.09016994374948), (19.021130325903066, -6.180339887498959, -19.75376681190275, 3.1286893008046257)]
  for i in 0..<20 {
    let (ia, ib, ic, theta) = inputs[i]
    let (ea, eb, ed, eq) = expected[i]
    let (alpha, beta) = @coord.clarke(ia, ib, ic)
    assert_true(approx_equal(alpha, ea, eps))
    assert_true(approx_equal(beta, eb, eps))
    let (d, q) = @coord.park(alpha, beta, theta)
    assert_true(approx_equal(d, ed, eps))
    assert_true(approx_equal(q, eq, eps))
  }
}
